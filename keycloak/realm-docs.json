{
  "realm": "docs",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "operator", "description": "Оператор: доступ к заявкам и документам соискателей" }
    ]
  },
  "clients": [
    {
      "clientId": "operator-ui",
      "name": "Рабочее место оператора",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5173/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      }
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "firstName": "Демо",
      "lastName": "Оператор",
      "email": "operator@example.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${OPERATOR_PASSWORD}", "temporary": false }],
      "realmRoles": ["operator", "default-roles-docs"]
    }
  ]
}
