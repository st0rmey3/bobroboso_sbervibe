# Copy to .env and fill. Never commit .env.

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg://app:change-me@db:5432/app

# --- Keycloak (OIDC) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# demo operator user created by realm import (login: operator)
OPERATOR_PASSWORD=change-me
# issuer as seen by the BROWSER (tokens carry it); JWKS fetched inside docker network
OIDC_ISSUER=http://localhost:8080/realms/docs
OIDC_JWKS_URL=http://keycloak:8080/realms/docs/protocol/openid-connect/certs
OIDC_CLIENT_ID=operator-ui

# --- LLM provider: openai (external, OpenAI-compatible) | ollama (local) ---
LLM_PROVIDER=openai
LLM_TIMEOUT_S=180

# local (Ollama). Native Ollama on the host: http://host.docker.internal:11434 ; container profile: http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Any OpenAI-compatible API: Sber-provided Qwen (https://llm.ilons.ru/v1, model Qwen/Qwen3.8-27B), OpenAI, DeepSeek, vLLM
OPENAI_BASE_URL=https://llm.ilons.ru/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B
# Qwen3-style reasoning models: true = skip thinking (~2x faster, same quality on our docs)
OPENAI_DISABLE_THINKING=true

# --- OCR (text recognition model): olmocr | ollama | tesseract | none ---
# olmocr = olmOCR-2 behind an OpenAI-compatible vLLM API (Sber's server or self-hosted).
# ollama = local OCR: a vision model in Ollama (OLLAMA_URL) transcribes the page, then the LLM extracts fields.
# tesseract = local CPU OCR inside the backend image; then a small TEXT model in Ollama is enough (e.g. qwen2.5:3b).
# none   = no separate OCR, the LLM reads page images itself (needs a vision model, e.g. local Ollama).
OCR_PROVIDER=none
# local OCR model for OCR_PROVIDER=ollama (empty = OLLAMA_MODEL)
OLLAMA_OCR_MODEL=
OCR_BASE_URL=http://ocr-host:8000/v1
OCR_API_KEY=
OCR_MODEL=allenai/olmOCR-2-7B-1025-FP8

# --- Worker ---
WORKER_CONCURRENCY=8
JOB_LEASE_S=60
JOB_MAX_ATTEMPTS=3

# --- Uploads ---
MAX_UPLOAD_MB=20
# page size sent to the model (px). Local model on 8 GB GPU: 1024
IMAGE_MAX_SIDE=1800
MAX_FILES_PER_APPLICATION=40
MAX_APPLICATION_MB=200

# --- Network: internal addresses never go through a proxy (Docker Desktop may inject one) ---
NO_PROXY=localhost,127.0.0.1,host.docker.internal,keycloak,db,ollama,backend,frontend
no_proxy=localhost,127.0.0.1,host.docker.internal,keycloak,db,ollama,backend,frontend
